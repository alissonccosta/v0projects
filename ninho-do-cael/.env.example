# Ninho do Cael — variáveis de ambiente (SDD, seção 7.3)
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local nem exponha SUPABASE_SERVICE_ROLE_KEY ou
# NOTION_ACCESS_TOKEN no cliente: essas variáveis são somente de servidor.

# --- Supabase ---------------------------------------------------------------
# URL do projeto Supabase (Configurações > API).
NEXT_PUBLIC_SUPABASE_URL=
# Chave publishable (segura para o navegador; RLS controla o acesso).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave service_role. SOMENTE SERVIDOR. Não use em código com "use client".
SUPABASE_SERVICE_ROLE_KEY=

# --- Notion -----------------------------------------------------------------
# Token da integração interna do Notion. SOMENTE SERVIDOR.
NOTION_ACCESS_TOKEN=
# Segredo para validar assinaturas de webhook do Notion.
NOTION_WEBHOOK_SECRET=
# Versão da API do Notion utilizada pela camada server-side.
NOTION_VERSION=2026-03-11

# IDs das seis fontes de dados do Notion (SDD, seção 7.1).
NOTION_NEEDS_DATA_SOURCE_ID=ce3fe570-7121-4e8f-a63a-0e89bbf11d28
NOTION_PRODUCTS_DATA_SOURCE_ID=eec3bfd4-0785-4846-8355-552a83215e46
NOTION_PURCHASES_DATA_SOURCE_ID=5703fbdc-8707-42b1-b08b-a59abcf0b903
NOTION_INVENTORY_DATA_SOURCE_ID=521896bd-ffaa-43fb-aa4e-9739a1bbc558
NOTION_TASKS_DATA_SOURCE_ID=221db659-addc-4b1c-a0e5-ad35a3d998c7
NOTION_DECISIONS_DATA_SOURCE_ID=ccce3fe5-2a2e-4b63-ae83-925c3b4d6403

# --- Aplicação ---------------------------------------------------------------
# Segredo exigido pelos endpoints de jobs agendados (reconciliação periódica).
CRON_SECRET=
# URL pública da aplicação (ex.: https://ninho-do-cael.vercel.app).
APP_URL=
